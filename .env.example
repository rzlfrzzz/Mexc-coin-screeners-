# ============================================================
# SMART MONEY SCREENING BOT - MEXC FUTURES (USDT-M Perpetual) ONLY
# Salin file ini menjadi ".env" lalu isi semua nilai di bawah.
#   cp .env.example .env
# JANGAN commit file ".env" ke git (sudah ada di .gitignore)
# ============================================================

# ---------- EXCHANGE ----------
# Bot ini HANYA untuk MEXC Futures (USDT-M Perpetual) - exchange sengaja di-hardcode
# di config.py, tidak bisa diganti lewat .env.
# Bot ini HANYA memakai endpoint publik (OHLCV, ticker, order book), jadi TIDAK
# butuh API key/secret exchange sama sekali - tidak ada variabel untuk itu di sini.
# EXCHANGE_SANDBOX SENGAJA TIDAK DIDUKUNG: MEXC tidak punya sandbox/testnet di ccxt.
# Kalau di-set true di sini, bot akan tetap jalan ke live market MEXC dan hanya menampilkan warning.

# Daftar simbol yang di-scan, pisahkan dengan koma.
# WAJIB format perpetual ccxt "BASE/QUOTE:QUOTE", contoh "BTC/USDT:USDT" (bukan "BTC/USDT" saja).
# Dipakai penuh kalau WATCHLIST_MODE=static, atau sebagai watchlist awal/fallback
# kalau WATCHLIST_MODE=dynamic (sebelum refresh pertama berhasil / kalau fetch gagal).
WATCHLIST_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,BNB/USDT:USDT

# Mode watchlist:
#   static  = selalu pakai WATCHLIST_SYMBOLS di atas apa adanya
#   dynamic = auto top-N symbol MEXC Futures berdasarkan volume transaksi 24 jam
#             (quoteVolume), di-refresh otomatis tiap WATCHLIST_REFRESH_HOURS jam
WATCHLIST_MODE=static
# Jumlah symbol top-volume yang diambil kalau WATCHLIST_MODE=dynamic
WATCHLIST_TOP_N=20
# Interval refresh watchlist dinamis dalam JAM (mis. 12 = refresh tiap 12 jam, 24 = tiap hari)
WATCHLIST_REFRESH_HOURS=12
# Quote currency untuk filter pair saat mode dynamic (MEXC Futures USDT-M -> USDT)
WATCHLIST_QUOTE=USDT

# Timeframe yang dipakai tiap layer (format ccxt: 1m,5m,15m,1h,4h,1d)
TF_HTF=4h
TF_MTF=1h

# Interval scanning dalam detik (mis. 300 = tiap 5 menit)
SCAN_INTERVAL_SECONDS=300

# ---------- SUPABASE ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY
SUPABASE_SIGNALS_TABLE=signals
SUPABASE_LAYER_LOG_TABLE=layer_logs

# ---------- TELEGRAM ----------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat ID / Channel ID / Group ID tujuan pengiriman signal
# Untuk channel/grup biasanya diawali dengan tanda minus, mis. -1001234567890
TELEGRAM_CHAT_ID=

# ---------- FILTER / THRESHOLD DASAR ----------
MIN_VOLUME_24H_USD=5000000
MAX_SPREAD_PCT=0.15
MIN_ATR_PCT=0.2
MAX_1H_PUMP_DUMP_PCT=15
VOLUME_SPIKE_MULTIPLIER=1.5
RSI_LONG_MIN=55
RSI_SHORT_MAX=45

# ---------- SCORING THRESHOLD ----------
SCORE_MIN_TO_SEND=70

# ---------- LOGGING ----------
LOG_LEVEL=INFO

# ============================================================
# SMART MONEY SCREENING BOT - MEXC FUTURES (USDT-M Perpetual) ONLY
# Salin file ini menjadi ".env" lalu isi semua nilai di bawah.
#   cp .env.example .env
# JANGAN commit file ".env" ke git (sudah ada di .gitignore)
# ============================================================

# ---------- EXCHANGE ----------
# Bot ini HANYA untuk MEXC Futures (USDT-M Perpetual) - exchange sengaja di-hardcode
# di config.py, tidak bisa diganti lewat .env.
# Bot ini HANYA memakai endpoint publik (OHLCV, ticker, order book), jadi TIDAK
# butuh API key/secret exchange sama sekali - tidak ada variabel untuk itu di sini.
# EXCHANGE_SANDBOX SENGAJA TIDAK DIDUKUNG: MEXC tidak punya sandbox/testnet di ccxt.
# Kalau di-set true di sini, bot akan tetap jalan ke live market MEXC dan hanya menampilkan warning.

# Daftar simbol yang di-scan, pisahkan dengan koma.
# WAJIB format perpetual ccxt "BASE/QUOTE:QUOTE", contoh "BTC/USDT:USDT" (bukan "BTC/USDT" saja).
# Dipakai penuh kalau WATCHLIST_MODE=static, atau sebagai watchlist awal/fallback
# kalau WATCHLIST_MODE=dynamic (sebelum refresh pertama berhasil / kalau fetch gagal).
WATCHLIST_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,BNB/USDT:USDT

# Mode watchlist:
#   static  = selalu pakai WATCHLIST_SYMBOLS di atas apa adanya
#   dynamic = auto top-N symbol MEXC Futures berdasarkan volume transaksi 24 jam
#             (quoteVolume), di-refresh otomatis tiap WATCHLIST_REFRESH_HOURS jam
WATCHLIST_MODE=static
# Jumlah symbol top-volume yang diambil kalau WATCHLIST_MODE=dynamic
WATCHLIST_TOP_N=20
# Interval refresh watchlist dinamis dalam JAM (mis. 12 = refresh tiap 12 jam, 24 = tiap hari)
WATCHLIST_REFRESH_HOURS=12
# Quote currency untuk filter pair saat mode dynamic (MEXC Futures USDT-M -> USDT)
WATCHLIST_QUOTE=USDT

# ---------- TIMEFRAME (format ccxt: 1m,5m,15m,1h,4h,1d) ----------
# V2: dipisah jadi 3 tingkat, bukan satu TF_MTF untuk semuanya (lihat ringkasan_perbaikan.md P1):
TF_HTF=4h        # Layer 2 (trend besar/EMA200) & Layer 0 (BTC regime)
TF_STRUCTURE=1h  # Layer 1 (ATR/pump-dump), Layer 3 (struktur/BOS/CHoCH), Layer 4 (SMC: OB/FVG/sweep)
TF_ENTRY=15m     # Layer 5 (momentum), Layer 6 (volume), Layer 7 (entry trigger), harga entry di Layer 8
# CATATAN MIGRASI: TF_MTF (nama lama) masih dibaca sebagai fallback kalau TF_STRUCTURE
# belum diisi, tapi mulai sekarang gunakan TF_STRUCTURE.

# Timeframe untuk MENGECEK outcome (SL/TP1/2/3 mana yang tersentuh duluan) - sengaja
# lebih granular dari TF_STRUCTURE *dan* TF_ENTRY, supaya urutan kejadian di dalam satu
# candle sinyal (1H) ATAU satu candle entry (15M) bisa dibedakan, bukan ditebak. Default
# 5m (bukan 15m/sama dengan TF_ENTRY lagi - itu tidak benar2 granular). Dipakai oleh
# outcome_tracker.py (live) & backtest.py lewat fungsi terpusat trade_outcome.evaluate_trade_path().
TF_OUTCOME=5m
# Kalau SL & TP masih tersentuh di candle TF_OUTCOME yang SAMA (masih ambigu walau
# sudah granular): "conservative_sl_first" (default, tidak melebih-lebihkan win rate)
# atau "conservative_tp_first" (upper-bound optimistis, cocok untuk sensitivity check).
OUTCOME_SAME_BAR_POLICY=conservative_sl_first

# Interval scanning dalam detik (mis. 300 = tiap 5 menit)
SCAN_INTERVAL_SECONDS=300

# ---------- SUPABASE ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY
SUPABASE_SIGNALS_TABLE=signals
SUPABASE_LAYER_LOG_TABLE=layer_logs

# ---------- TELEGRAM ----------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat ID / Channel ID / Group ID tujuan pengiriman signal
# Untuk channel/grup biasanya diawali dengan tanda minus, mis. -1001234567890
TELEGRAM_CHAT_ID=

# ---------- FILTER / THRESHOLD DASAR ----------
MIN_VOLUME_24H_USD=5000000
MAX_SPREAD_PCT=0.15
MIN_ATR_PCT=0.2
MAX_1H_PUMP_DUMP_PCT=15
VOLUME_SPIKE_MULTIPLIER=1.5
RSI_LONG_MIN=55
RSI_SHORT_MAX=45

# ---------- LAYER 0 - BTC MARKET REGIME (baru) ----------
# Kalau true, altcoin di-skip kalau direction-nya berlawanan dengan trend 4H BTC yang jelas.
ENABLE_BTC_REGIME_FILTER=true
BTC_REGIME_SYMBOL=BTC/USDT:USDT
BTC_REGIME_REFRESH_MINUTES=30

# ---------- LAYER 1b - FUNDING RATE (baru, khusus futures) ----------
ENABLE_FUNDING_FILTER=true
# Batas absolut funding rate per interval funding (persen). Di atas ini dianggap crowded trade.
MAX_FUNDING_RATE_ABS_PCT=0.75

# ---------- LAYER 3 - ADAPTIVE SWING LOOKBACK (baru, menggantikan konstanta N=3) ----------
SWING_LOOKBACK_MIN=2
SWING_LOOKBACK_DEFAULT=3
SWING_LOOKBACK_MAX=6
SWING_LOOKBACK_LOW_ATR_PCT=0.5
SWING_LOOKBACK_HIGH_ATR_PCT=1.5

# ---------- LAYER 7 - ENTRY TRIGGER: CONTEXT-AWARENESS (perbaikan) ----------
# Trigger 15M (displacement + engulfing/breakout) HARUS punya hubungan nyata dengan area
# SMC 1H (Order Block/FVG/Liquidity Sweep dari Layer 4) - lihat layers/layer7_entry_trigger.py.
# Jumlah candle ENTRY (15M) tepat SEBELUM window displacement yang dicek apakah range
# harganya (wick) bersinggungan dengan OB/FVG 1H valid searah.
TRIGGER_CONTEXT_LOOKBACK_BARS=6
# Umur maksimum liquidity sweep 1H (dalam jumlah candle STRUCTURE/1H) supaya masih dianggap
# relevan sebagai alasan trigger 15M sekarang - sweep yang lebih tua dari ini diabaikan.
TRIGGER_CONTEXT_SWEEP_MAX_AGE_BARS=12

# ---------- LAYER 6b - OPEN INTEREST: PRICE x OI DIRECTIONAL MODEL ----------
# OI_CONFIRMATION_MIN_CHANGE_PCT = threshold leg OI (%) dari price x OI directional model
# (lihat indicators/technical.py::classify_price_oi_direction) - BUKAN lagi "OI naik = bullish"
# naif, sekarang diklasifikasi LONG_BUILDUP/SHORT_BUILDUP/SHORT_COVERING/LONG_LIQUIDATION.
OI_CONFIRMATION_MIN_CHANGE_PCT=2.0
# OI_PRICE_MIN_CHANGE_PCT = threshold leg PRICE (%) dari model yang sama - price & OI
# harus SAMA-SAMA melewati threshold masing2 sebelum diklasifikasi (bukan NEUTRAL).
OI_PRICE_MIN_CHANGE_PCT=0.15

# ---------- RELIABILITAS - RETRY & CANDLE-CLOSED CHECK (baru) ----------
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_SEC=0.5
# Buang candle terakhir yang masih "live"/belum closed dari hasil fetch OHLCV, supaya
# sinyal (terutama Layer 7 entry trigger) tidak "repaint"/berubah antar-scan.
DROP_UNCLOSED_CANDLE=true

# ---------- LAYER 1 - THRESHOLD RELATIF PER-COIN (baru) ----------
# Selain floor absolut (MIN_VOLUME_24H_USD, MIN_ATR_PCT), tambahkan cek percentile
# terhadap histori masing-masing coin sendiri, supaya threshold tidak sama rata untuk
# BTC dan low-cap altcoin.
ENABLE_RELATIVE_ATR_FILTER=true
MIN_ATR_PERCENTILE=20
ENABLE_RELATIVE_VOLUME_FILTER=true
MIN_VOLUME_PERCENTILE=25
PERCENTILE_MIN_HISTORY=100

# ---------- OUTCOME TRACKING OTOMATIS (baru) ----------
# Menentukan otomatis apakah SL/TP1/2/3 tersentuh untuk tiap sinyal yang sudah dikirim,
# supaya win-rate riil bisa dihitung (bukan permanen kosong). Jalan di scheduler terpisah
# dari scan_watchlist (lihat main.py), interval lebih jarang.
ENABLE_OUTCOME_TRACKING=true
OUTCOME_TRACKING_INTERVAL_SECONDS=3600
# Sinyal yang belum SL/TP setelah sekian jam ditandai OPEN_EXPIRED (bukan menggantung selamanya)
OUTCOME_MAX_AGE_HOURS=72
# CATATAN MIGRASI: label outcome berubah dari versi sebelumnya (WIN_TP1/WIN_TP2/WIN_TP3/
# LOSS_SL/TIMEOUT) menjadi TP1_FIRST/TP2_FIRST/TP3_FIRST/SL_FIRST/OPEN_EXPIRED - karena
# outcome sekarang ditentukan oleh EVENT PERTAMA yang tersentuh (lihat trade_outcome.py),
# bukan level terjauh yang PERNAH tersentuh sepanjang riwayat sinyal. Jalankan migrasi di
# supabase_schema.sql (kolom mfe_pct/mae_pct/time_to_outcome_hours/ambiguous_same_bar baru)
# sebelum menjalankan versi ini di atas database yang sudah ada.

# ---------- SCORING THRESHOLD ----------
SCORE_MIN_TO_SEND=70

# ---------- SCORING V2 (Phase 7 - lihat config.py::scoring_weights & layers/layer9_scoring.py) ----------
# Bobot per kategori (regime_4h, structure_1h, liquidity_event, smc_location, entry_trigger_15m,
# volume, momentum, oi, risk_quality) TIDAK dibaca dari .env (masih hardcode di config.py seperti
# skema lama) - ubah langsung Settings.scoring_weights kalau perlu menyesuaikan bobot.

# Correlation awareness (metadata, TIDAK mempengaruhi skor) - kalau >= N symbol LAIN sudah
# menghasilkan sinyal SEARAH di scan yang sama, signal ditandai high_correlation_risk di
# Telegram/Supabase (kemungkinan BTC-beta/market-wide move, bukan edge independen per-coin).
CORRELATION_WARN_THRESHOLD=3

# ---------- LOGGING ----------
LOG_LEVEL=INFO

# ---------- PHASE 8 - OPTIMIZATION (lihat README.md bagian "Optimasi Parameter" & "Watchlist Size") ----------
# Tidak ada variabel .env baru untuk Phase 8 - optimize.py, analyze_live_params.py, dan
# watchlist_stress_test.py bekerja dengan MEMBACA/MENGUBAH SEMENTARA nilai settings yang
# SUDAH ADA di atas (mis. MIN_ATR_PCT, VOLUME_SPIKE_MULTIPLIER, WATCHLIST_TOP_N) lewat
# monkeypatch in-process saat eksperimen, lalu mengembalikannya - bukan lewat .env terpisah.
# Metrics scan (scan_duration_ms, request_count, dst - lihat core/metrics.py) otomatis
# tersimpan ke tabel scan_metrics di Supabase, tidak butuh konfigurasi tambahan selain
# SUPABASE_URL/SUPABASE_KEY yang sudah diisi di atas.
